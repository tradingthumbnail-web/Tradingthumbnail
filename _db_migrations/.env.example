# Local-only migration credentials (copy to .env — never commit .env)
OLD_DB_CONNECTION_STRING=
NEW_DB_CONNECTION_STRING=

# Source S3 (legacy bucket)
OLD_AWS_ACCESS_KEY=
OLD_AWS_SECRET_KEY=
OLD_AWS_REGION=eu-west-1
OLD_BUCKET=

# Destination S3 (new bucket)
NEW_AWS_ACCESS_KEY=
NEW_AWS_SECRET_KEY=
NEW_AWS_REGION=eu-west-1
NEW_BUCKET=

ENVIRONMENT=production

# Optional: standard AWS names are used only when explicit keys above are empty
# and boto3 falls back to the default credential chain (profile, ~/.aws/credentials, IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
