# =============================================================================
# Local Postgres (docker-compose.yml → service `db`)
# =============================================================================
# Copy to config/db.env (gitignored via root `.gitignore` → `config/`):
#   mkdir -p config
#   cp config/db.env.example config/db.env
#
# Then start Postgres:
#   docker compose up -d db
#
# Connection string for the Nuxt app (.env.dev):
#   NUXT_DATABASE_CONNECTION_STRING=postgresql://kithumbs:kithumbs@localhost:5432/kithumbs
# =============================================================================

POSTGRES_USER=kithumbs
POSTGRES_PASSWORD=kithumbs
POSTGRES_DB=kithumbs
